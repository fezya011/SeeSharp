@page "/hand"
@rendermode InteractiveServer
@implements IAsyncDisposable

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <h1 class="text-center mb-4">Детекция рук (MediaPipe)</h1>
            <p class="text-center text-muted">21 сустав | Распознавание жестов | Real-time</p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">🖐️ Real-time детекция</h4>
                </div>
                <div class="card-body">
                    <div style="position: relative;">
                        <video id="handVideo" autoplay playsinline style="width: 100%; border-radius: 8px; background: #000; transform: scaleX(-1);"></video>
                        <canvas id="handOverlay" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none;"></canvas>
                    </div>

                    <div class="mt-3">
                        <div class="d-flex gap-2 justify-content-between align-items-center">
                            <div>
                                <button class="btn @(isDetecting ? "btn-danger" : "btn-success")" @onclick="ToggleDetection">
                                    @if (isDetecting)
                                    {
                                        <span>Остановить</span>
                                    }
                                    else
                                    {
                                        <span>Запустить детекцию</span>
                                    }
                                </button>
                            </div>

                            <div>
                                <span class="badge bg-success fs-6">👋 Рук: @handsCount</span>
                                <span class="badge bg-info fs-6 ms-2">⚡ @fps FPS</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">Распознанный жест</h4>
                </div>
                <div class="card-body text-center">
                    @if (!string.IsNullOrEmpty(currentGesture))
                    {
                        <div class="alert alert-info mb-2">
                            <div style="font-size: 64px;">@GetGestureIcon()</div>
                            <h4>@currentGesture</h4>
                            <div class="mt-2">
                                <span class="badge bg-secondary fs-6">@raisedFingersCount пальцев поднято</span>
                            </div>
                        </div>

                        @if (currentGesture.Contains("Ладонь"))
                        {
                            <div class="alert alert-success mt-2">
                                Жест распознан!
                            </div>
                        }
                        else if (currentGesture.Contains("Кулак"))
                        {
                            <div class="alert alert-warning mt-2">
                                Кулак обнаружен
                            </div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-secondary">
                            <div style="font-size: 48px;"></div>
                            <p>Нажмите "Запустить детекцию"<br />и покажите руку в камеру</p>
                        </div>
                    }
                </div>
            </div>

            <div class="card shadow-sm mt-3">
                <div class="card-header bg-info text-white">
                    <h4 class="mb-0">Статистика</h4>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <span>Состояние:</span>
                        <strong>@(isDetecting ? "Активна" : "Остановлена")</strong>
                    </div>
                    <div class="d-flex justify-content-between mt-2">
                        <span>Последний жест:</span>
                        <strong>@(currentGesture ?? "—")</strong>
                    </div>
                    <div class="d-flex justify-content-between mt-2">
                        <span>Всего обнаружений:</span>
                        <strong>@totalDetections</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .gap-2 {
        gap: 0.5rem;
    }

    .btn {
        min-width: 120px;
    }

    .badge {
        font-size: 0.85rem;
        padding: 0.35rem 0.65rem;
    }

    .fs-6 {
        font-size: 1rem !important;
    }
</style>

@code {
    private int handsCount = 0;
    private string? currentGesture;
    private int raisedFingersCount = 0;
    private int fps = 0;
    private bool isDetecting = false;
    private int totalDetections = 0;
    private DotNetObjectReference<HandPage>? dotNetRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("setHandDotNetReference", dotNetRef);
            await InitializeCamera();
        }
    }

    private async Task InitializeCamera()
    {
        try
        {
            var success = await JS.InvokeAsync<bool>("startHandCamera");
            if (!success)
            {
                Console.WriteLine("Failed to start hand camera");
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Camera error: {ex.Message}");
        }
    }

    [JSInvokable]
    public async Task OnHandDetected(int hands, int raisedFingers, string gesture, int fpsValue)
    {
        if (!isDetecting) return;

        handsCount = hands;
        raisedFingersCount = raisedFingers;
        fps = fpsValue;

        if (currentGesture != gesture)
        {
            currentGesture = gesture;
            totalDetections++;

            await OnGestureChanged(gesture);
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task OnGestureChanged(string gesture)
    {
        Console.WriteLine($"Gesture changed to: {gesture}");

        switch (gesture)
        {
            case "Ладонь":
                break;
            case "Кулак":
                break;
            case "Мир":
                break;
        }

        await Task.CompletedTask;
    }

    private string GetGestureIcon()
    {
        if (string.IsNullOrEmpty(currentGesture)) return "";

        return currentGesture switch
        {
            string g when g.Contains("Кулак") => "✊",
            string g when g.Contains("Указательный") => "☝️",
            string g when g.Contains("Мир") => "✌️",
            string g when g.Contains("Окей") => "👌",
            string g when g.Contains("Коза") => "🤘",
            string g when g.Contains("Ладонь") => "🖐️",
            _ => "🖐️"
        };
    }

    private async Task ToggleDetection()
    {
        if (isDetecting)
        {
            await JS.InvokeVoidAsync("stopHandRealTimeDetection");
            isDetecting = false;
            await JS.InvokeVoidAsync("clearHandCanvas");

            
        }
        else
        {
            isDetecting = true;
            await JS.InvokeVoidAsync("startHandRealTimeDetection");
        }
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (isDetecting)
            {
                await JS.InvokeVoidAsync("stopHandRealTimeDetection");
            }
            await JS.InvokeVoidAsync("stopHandCamera");
            dotNetRef?.Dispose();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Dispose error: {ex.Message}");
        }
    }

    [Inject] protected IJSRuntime JS { get; set; }
}